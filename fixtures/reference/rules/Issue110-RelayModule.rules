
(rules PCB Issue110-RelayModule
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.1)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.5)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 2000.2 (type HighVoltage))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_800:400_um-HighVoltage" "Via[0-1]_800:400_um" HighVoltage
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (viaRule
    HighVoltage "Via[0-1]_800:400_um-HighVoltage"
  )
  (class default
    /LED "unconnected-(K1-Pad5)" "unconnected-(K2-Pad5)" GND +5V +3V3 "/Система питания/Питание_12В" /KN1
    /KN6 /KN2 /KN3 /KN4 /KN5 "Net-(R2-Pad2)" "/OSC_IN" "/OSC_OUT"
    /SWDIO /SWCLK /NRST "/ESP_TX" "/ESP_RX" "/ESP_RST" "/ESP_CH_PD" "/ESP_GPIO0"
    "/USART_RX" "/USART_TX" "/COMP_DTR" "/CAN_TX" "Net-(Q1-Pad2)" "Net-(Q2-Pad2)" "/REL_CH1" "/REL_CH2"
    "/CAN_RX" "unconnected-(D1-Pad5)" "Net-(K1-Pad1)" "Net-(K2-Pad1)" "Net-(R1-Pad1)" "Net-(VD4-Pad2)" "Net-(D1-Pad6)" "Net-(D1-Pad7)"
    "unconnected-(U1-Pad1)" "unconnected-(U1-Pad2)" "unconnected-(U1-Pad3)" "unconnected-(U1-Pad4)" "unconnected-(U1-Pad10)" "unconnected-(U1-Pad14)" "unconnected-(U1-Pad15)" "unconnected-(U1-Pad16)"
    "unconnected-(U1-Pad22)" "unconnected-(U1-Pad25)" "unconnected-(U1-Pad26)" "unconnected-(U1-Pad27)" "unconnected-(U1-Pad28)" "unconnected-(U1-Pad38)" "unconnected-(U1-Pad44)" "/ESP_GPIO2"
    "unconnected-(XP2-Pad6)" "unconnected-(XP3-Pad1)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class HighVoltage
    "Net-(FU1-Pad1)" "Net-(K1-Pad2)" "Net-(FU2-Pad1)" "Net-(K2-Pad2)" "Net-(FU1-Pad2)" "Net-(FU2-Pad2)"
    (clearance_class HighVoltage)
    (via_rule HighVoltage)
    (rule
      (width 2000.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)