
(rules PCB Issue054-tairakb
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.2)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.9)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 163.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (class default
    GND /col6 "Net-(D1-Pad1)" /row1 "Net-(D2-Pad1)" /row2 "Net-(D3-Pad1)" /row3
    "Net-(D4-Pad1)" /row4 "Net-(D5-Pad1)" "Net-(D6-Pad1)" "Net-(D7-Pad1)" "Net-(D8-Pad1)" "Net-(D9-Pad1)" "Net-(D10-Pad1)"
    "Net-(D11-Pad1)" "Net-(D12-Pad1)" "Net-(D13-Pad1)" "Net-(D14-Pad1)" "Net-(D15-Pad1)" "Net-(D16-Pad1)" "Net-(D17-Pad1)" "Net-(D18-Pad1)"
    "Net-(D19-Pad1)" "Net-(D20-Pad1)" "Net-(D21-Pad1)" "Net-(D22-Pad1)" "Net-(D23-Pad1)" "Net-(D24-Pad1)" "Net-(D25-Pad1)" "Net-(D26-Pad1)"
    "Net-(D27-Pad1)" "Net-(D28-Pad1)" "Net-(D29-Pad1)" "Net-(D30-Pad1)" "Net-(D31-Pad1)" "Net-(D32-Pad1)" "Net-(D33-Pad1)" /RST
    VCC /col0 /col1 /col2 /col3 /col4 /col5 "Net-(U3-Pad13)"
    "Net-(U3-Pad6)" "Net-(U3-Pad5)" "Net-(U3-Pad2)" "Net-(U3-Pad1)" +BATT "Net-(BSW1-Pad1)" "Net-(BSW1-Pad2)" "Net-(U3-Pad12)"
    /row0
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)