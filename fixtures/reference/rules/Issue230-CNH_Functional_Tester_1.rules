
(rules PCB Issue230-CNH_Functional_Tester_1
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.2)
    )
    (layer_rule In1.Cu
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.2)
    )
    (layer_rule In2.Cu
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.2)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.8)
    )
  )
  (rule
    (width 254.0)
    (clearance 228.8)
    (clearance 127.0 (type smd_to_turn_gap))
    (clearance 57.2 (type smd))
    (clearance 635.2 (type +12V))
    (clearance 635.2 (type +5V))
    (clearance 635.2 (type +5VP))
    (clearance 635.2 (type +9V))
    (clearance 381.2 (type LOAD))
    (clearance 381.2 (type "UUT_LOAD"))
    (clearance 381.2 (type "UUT_PWR"))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-3]_635:304.8_um"
    (shape
      (circle F.Cu 635.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 635.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 635.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 635.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-3]_1143:381_um"
    (shape
      (circle F.Cu 1143.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 1143.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 1143.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 1143.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-3]_1066.8:304.8_um"
