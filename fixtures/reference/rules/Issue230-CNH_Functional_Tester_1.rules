      (circle F.Cu 1066.8 0.0 0.0)
    )
    (shape
      (circle In1.Cu 1066.8 0.0 0.0)
    )
    (shape
      (circle In2.Cu 1066.8 0.0 0.0)
    )
    (shape
      (circle B.Cu 1066.8 0.0 0.0)
    )
    (attach off)
  )
