
(rules PCB Issue269-caniot-tiny-arm
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.3)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.8)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (class default
    +3.3V GND +3.3VA /NRST "/HSE_IN" "/HSE_OUT" +5V "Net-(D5-K)"
    "Net-(D1-K)" "Net-(D3-A)" "Net-(D5-A)" "Net-(U1-PB6)" "Net-(U1-PB7)" "/TIM1_CH2" "Net-(U4-CANL)" "Net-(J10-Pin_1)"
    "Net-(D10-K)" +12V "Net-(J5-Pin_2)" "Net-(J7-Pin_4)" "Net-(J4-Pin_2)" VBUS "Net-(J4-Pin_3)" "Net-(J8-Pin_1)"
    "Net-(J2-Pin_4)" "/USB_D+" "/USB_D-" "Net-(FL1-D-_OUT)" "Net-(FL1-D+_OUT)" "unconnected-(J1-ID-Pad4)" "unconnected-(J1-Shield-Pad6)" /SWCLK
    /SWDIO "unconnected-(J4-Pin_1-Pad1)" "/GPIO_PC12" "/SP1_SCK" "/GPIO_PC13" "/SPI1_MOSI" "/GPIO_PC14" "/SP1_MISO"
    "/GPIO_PC15" "/GPIO_PB2" "/GPIO_PA10" "/USART3_CTS" /ADC0 "/USART3_RTS" /ADC1 "/USART3_TX"
    /ADC2 /ADC3 /ADC4 "/GPIO_PA15" /ADC5 "/I2C1_SDA" /ADC6 "/I2C1_SCL"
    /ADC7 "/USART4_RX" /ADC9 "/USART4_TX" /ADC8 "unconnected-(J6-Pad1)" /MCO "/TIM3_CH1"
    "/TIM3_CH2" "/TIM3_CH3" "/TIM3_CH4" "/TIM3_ETR" "/USER_BUTTON" "/SW_BOOT0" "Net-(J10-Pin_2)" "Net-(U1-BOOT0)"
    "Net-(R10-Pad2)" "/USER_LED" "unconnected-(U1-PC0-Pad8)" "unconnected-(U1-PC1-Pad9)" "unconnected-(U1-PC2-Pad10)" "unconnected-(U1-PC3-Pad11)" "unconnected-(U1-PC4-Pad24)" "unconnected-(U1-PC5-Pad25)"
    "/USART_RX" "/CAN_RX" "/CAN_TX" "unconnected-(U4-FAULT-Pad5)" "unconnected-(U4-S-Pad8)" "unconnected-(U6-INT{slash}CMPTR-Pad3)" "Net-(D2-K)" "Net-(D4-K)"
    "Net-(D4-A)" "unconnected-(S2-Pad1)" "unconnected-(S2-Pad3)" "unconnected-(S1-Pad1)" "unconnected-(S1-Pad3)" "Net-(J5-Pin_3)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)