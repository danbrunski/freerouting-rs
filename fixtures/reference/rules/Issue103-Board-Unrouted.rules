    /adrEx5 /datEx4 /adrEx4 /datEx3 /adrEx3 /datEx2 /adrEx2 /datEx1
    /adrEx1 /pcD1 /pcD2 /pcD3 /pcD4 /pcD5 /pcD6 /pcD7
