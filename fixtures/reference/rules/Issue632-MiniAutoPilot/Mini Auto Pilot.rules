    "unconnected-(S29-Pad4)" "unconnected-(S40-Pad2)" "unconnected-(S40-Pad4)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)