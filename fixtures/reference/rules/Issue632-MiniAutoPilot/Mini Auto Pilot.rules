    /D11 "unconnected-(S39-Pad2)" "unconnected-(S39-Pad4)" "unconnected-(J7-Pad57)" "unconnected-(J7-Pad58)" "unconnected-(J7-Pad59)" "unconnected-(J7-Pad60)" /D14
    "unconnected-(S42-Pad2)" "unconnected-(S42-Pad4)" /D16 "unconnected-(S23-Pad2)" "unconnected-(S23-Pad4)" /D1 /D2 /D3
