    "Net-(IC1-Pad63)" "Net-(IC1-Pad65)" "Net-(IC1-Pad76)" "Net-(IC1-Pad90)" "/Connector/BPCS_5" "/Connector/BPCS_4" "/Connector/BPCS_3" "/Connector/BPCS_2"
