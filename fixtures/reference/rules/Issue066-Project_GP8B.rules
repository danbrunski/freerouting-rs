
(rules PCB Issue066-Project_GP8B
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 3.2)
    )
    (layer_rule In1.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
    (layer_rule In2.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.4)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 2.5)
    )
  )
  (rule
    (width 180.0)
    (clearance 180.2)
    (clearance 90.0 (type smd_to_turn_gap))
    (clearance 45.0 (type smd))
    (clearance 200.2 (type Volt))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-3]_450:200_um"
    (shape
      (circle F.Cu 450.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 450.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 450.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 450.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-3]_550:300_um"
    (shape
      (circle F.Cu 550.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 550.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 550.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 550.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_450:200_um" "Via[0-3]_450:200_um" default
  )
  (via 
    "Via[0-3]_550:300_um" "Via[0-3]_550:300_um" default
  )
  (via 
    "Via[0-3]_450:200_um-Volt" "Via[0-3]_450:200_um" Volt
  )
  (via 
    "Via[0-3]_550:300_um-Volt" "Via[0-3]_550:300_um" Volt
  )
  (viaRule
    default "Via[0-3]_450:200_um"
  )
  (viaRule
    default "Via[0-3]_450:200_um"
  )
  (viaRule
    Volt "Via[0-3]_550:300_um-Volt"
  )
  (class default
    "Net-(D1-Pad2)" "/GLOBAL_CLK" "/RESET_CLK" "/RAM/RAMADDRESS_0" "/RAM/RAMADDRESS_1" "/RAM/RAMADDRESS_2" "/RAM/RAMADDRESS_3" "/RAM/RAMADDRESS_4"
    "/RAM/RAMADDRESS_5" "/RAM/RAMADDRESS_6" "/RAM/RAMADDRESS_7" "/RAM/RAMADDRESS_8" "/RAM/RAMADDRESS_9" "/RAM/RAMADDRESS_10" "/RAM/RAMADDRESS_11" "/RAM/RAMADDRESS_12"
    "/RAM/RAMADDRESS_13" "/RAM/RAMADDRESS_14" "/RAM/RAMADDRESS_15" "/RAM/RAM_~WE" "/RAM_OE_CONTROL" "/~IF_RESULT" "/IF_RESULT" "/NUM_SELECT_0"
    "/NUM_SELECT_1" "/Instruction/COUNTER_OUT_0" "/Instruction/COUNTER_OUT_1" "Net-(U8-Pad11)" "Net-(U8-Pad15)" "/Instruction/COUNTER_2" "/Instruction/I_IF" "/Instruction/I_IFNOT"
