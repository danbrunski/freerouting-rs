    (clearance_class default)
    (via_rule default)
    (rule
      (width 180.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
  (class Volt
    GND +5V +3V3
    (clearance_class Volt)
    (via_rule Volt)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu B.Cu)
    )
  )
