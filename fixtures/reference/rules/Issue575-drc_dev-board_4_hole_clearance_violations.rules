
(rules PCB Issue575-drc_dev-board_4_hole_clearance_violations
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.8)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.6)
    )
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type Power,Default))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-Power,Default" "Via[0-1]_600:300_um" Power,Default
  )
  (viaRule
    default "Via[0-1]_600:300_um"
  )
  (viaRule
    default "Via[0-1]_600:300_um"
  )
  (viaRule
    Power,Default "Via[0-1]_600:300_um-Power,Default"
  )
  (class default
    GND EN "unconnected-(J1-SBU1-PadA8)" "D-" "Net-(J1-CC1)" D+ "Net-(J1-CC2)" "unconnected-(J1-SBU2-PadB8)"
    GPIO11 GPIO46 GPIO10 GPIO6 GPIO9 GPIO5 GPIO12 GPIO18
    GPIO16 GPIO15 GPIO7 GPIO8 GPIO4 GPIO3 GPIO17 GPIO40
    GPIO45 GPIO41 GPIO0 GPIO38 GPIO2 GPIO39 GPIO36 GPIO47
    GPIO35 GPIO13 GPIO44 GPIO14 GPIO37 GPIO1 GPIO21 GPIO48
    GPIO42 GPIO43 "Net-(D1-A)" "Net-(D2-A)" "Net-(D3-A)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power,Default
    +3V3 +5V
    (clearance_class Power,Default)
    (via_rule Power,Default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)