
(rules PCB Issue733-kicad_interf_u_input_design
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule "top_copper"
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.1)
    )
    (layer_rule "bottom_copper"
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.9)
    )
  )
  (rule
    (width 400.0)
    (clearance 254.0)
    (clearance 200.0 (type smd_to_turn_gap))
    (clearance 63.6 (type smd))
    (clearance 254.0 (type Power))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_1400:600_um"
    (shape
      (circle "top_copper" 1400.0 0.0 0.0)
    )
    (shape
      (circle "bottom_copper" 1400.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1600:600_um"
    (shape
      (circle "top_copper" 1600.0 0.0 0.0)
    )
    (shape
      (circle "bottom_copper" 1600.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1397:600_um"
    (shape
      (circle "top_copper" 1397.0 0.0 0.0)
    )
    (shape
      (circle "bottom_copper" 1397.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1397:635_um"
    (shape
      (circle "top_copper" 1397.0 0.0 0.0)
    )
    (shape
      (circle "bottom_copper" 1397.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1524:600_um"
    (shape
      (circle "top_copper" 1524.0 0.0 0.0)
    )
    (shape
      (circle "bottom_copper" 1524.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_1143:600_um"
    (shape
      (circle "top_copper" 1143.0 0.0 0.0)
    )
    (shape
      (circle "bottom_copper" 1143.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_1400:600_um" "Via[0-1]_1400:600_um" default
  )
  (via 
    "Via[0-1]_1600:600_um" "Via[0-1]_1600:600_um" default
  )
