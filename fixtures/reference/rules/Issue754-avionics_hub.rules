
(rules PCB Issue754-avionics_hub
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 2.2)
      (against_preferred_direction_trace_costs 3.5)
    )
    (layer_rule Ground
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
    (layer_rule In2.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.3)
    )
    (layer_rule In3.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
    (layer_rule In4.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.3)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 2.2)
      (against_preferred_direction_trace_costs 2.9)
    )
  )
  (rule
    (width 250.0)
    (clearance 250.0)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 62.6 (type smd))
    (clearance 250.0 (type "4A gnd,Default"))
    (clearance 250.0 (type "4A_pwr,Default"))
    (clearance 250.0 (type "3A_pwr,Default"))
    (clearance 250.0 (type "3A gnd,Default"))
    (clearance 320.0 (type Diff,Default))
    (clearance 250.0 (type "2A_pwr,Default"))
    (clearance 250.0 (type "2A_gnd,Default"))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-5]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle Ground 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In3.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In4.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-5]_650:300_um"
    (shape
      (circle F.Cu 650.0 0.0 0.0)
    )
    (shape
      (circle Ground 650.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 650.0 0.0 0.0)
    )
    (shape
      (circle In3.Cu 650.0 0.0 0.0)
    )
    (shape
      (circle In4.Cu 650.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 650.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-5]_450:300_um"
    (shape
      (circle F.Cu 450.0 0.0 0.0)
    )
    (shape
      (circle Ground 450.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 450.0 0.0 0.0)
    )
    (shape
      (circle In3.Cu 450.0 0.0 0.0)
    )
    (shape
      (circle In4.Cu 450.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 450.0 0.0 0.0)
    )
    (attach off)
  )
