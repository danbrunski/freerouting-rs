
(rules PCB Issue217-8088sbc
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 300.2 (type Power))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_800:400_um-Power" "Via[0-1]_800:400_um" Power
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (viaRule
    Power "Via[0-1]_800:400_um-Power"
  )
  (class default
    "Net-(D1-A)" "Net-(D1-K)" "Net-(J1-Pin_1)" "Net-(J1-Pin_2)" "Net-(J1-Pin_3)" "Net-(J1-Pin_4)" "Net-(J1-Pin_5)" "Net-(J1-Pin_6)"
    "Net-(J1-Pin_7)" "Net-(J1-Pin_8)" "Net-(J2-Pin_8)" "Net-(J2-Pin_7)" "Net-(J2-Pin_6)" "Net-(J2-Pin_5)" "Net-(J2-Pin_4)" "Net-(J2-Pin_3)"
    "Net-(J2-Pin_2)" "Net-(J2-Pin_1)" "Net-(J3-Pin_1)" "Net-(J3-Pin_2)" "Net-(J3-Pin_3)" "Net-(J3-Pin_4)" "Net-(J3-Pin_5)" "Net-(J3-Pin_6)"
    /RESET "Net-(J3-Pin_7)" "Net-(J3-Pin_8)" "Net-(JP1-C)" "Net-(U5-OSC1)" "Net-(JP2-A)" "Net-(JP2-C)" "Net-(JP2-B)"
    "/Clock generator/Co" "Net-(U5-OSC2)" "Net-(U101B-~{Q})" /A14 /A13 /A12 "Net-(U101A-C)" /A11
    /A10 "unconnected-(U101B-Q-Pad9)" /A9 /A8 /D7 "unconnected-(U1-READY-Pad22)" /D6 "unconnected-(U1-~{INTA}-Pad24)"
    /D5 /D4 "unconnected-(U1-DEN-Pad26)" /D3 /D2 "unconnected-(U1-DT{slash}~{R}-Pad27)" /D1 "Net-(U1-IO{slash}~{M})"
    /D0 "Net-(U1-WR)" "unconnected-(U1-HLDA-Pad30)" "Net-(U1-~{RD})" /A15 /~{MW} /A0 /A1
    /~{MR} /A2 /A3 /A4 /A5 /A6 /A7 "unconnected-(U1-~{SSO}-Pad34)"
    /~{IOW} /~{A7} /~{IOR} "unconnected-(U1-A19{slash}S6-Pad35)" "unconnected-(U1-A18{slash}S5-Pad36)" "unconnected-(U1-A17{slash}S4-Pad37)" "unconnected-(U1-A16{slash}S3-Pad38)" "Net-(U3-~{CE})"
    "unconnected-(U5-~{STBY}-Pad16)" "Net-(U5-~{IRQ})" "unconnected-(U5-CKFS-Pad20)" "unconnected-(U5-CKOUT-Pad21)" "unconnected-(U5-PS-Pad22)" "unconnected-(U5-SQW-Pad23)" "unconnected-(U7-O7-Pad7)" /ALE
    /INTR "unconnected-(U7-O4-Pad11)" "Net-(C13-Pad2)" "unconnected-(U7-O3-Pad12)" "unconnected-(U7-O0-Pad15)" "unconnected-(J5-Pin_4-Pad4)" "unconnected-(J5-Pin_3-Pad3)" "unconnected-(J5-Pin_2-Pad2)"
    /~{RESET} "unconnected-(U8-Pad10)" "unconnected-(U8-Pad12)" "unconnected-(U9-Pad6)" "unconnected-(U9-Pad8)" "unconnected-(U9-Pad11)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power
    +5V GND
    (clearance_class Power)
    (via_rule Power)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)