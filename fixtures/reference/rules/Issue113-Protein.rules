    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class pwr
    GND +5V +3V3 "74XX_PWR" "CPLD_PWR"
    (clearance_class pwr)
    (via_rule pwr)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)