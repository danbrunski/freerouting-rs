
(rules PCB Issue872-single-layer-repro
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.3)
    )
  )
  (rule
    (width 400.0)
    (clearance 250.0)
    (clearance 200.0 (type smd_to_turn_gap))
    (clearance 62.6 (type smd))
    (clearance 1200.0 (type Mains))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-0]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-0]_600:300_um" "Via[0-0]_600:300_um" default
  )
  (via 
    "Via[0-0]_600:300_um-Mains" "Via[0-0]_600:300_um" Mains
  )
  (viaRule
    default "Via[0-0]_600:300_um"
  )
  (viaRule
    default "Via[0-0]_600:300_um"
  )
  (viaRule
    Mains "Via[0-0]_600:300_um-Mains"
  )
  (class default
    +5V GND "RELAY_CTL" "Q1_BASE" "RELAY_DRV" "LED_A"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu)
    )
  )
  (class Mains
    "AC_COM" "AC_NO"
    (clearance_class Mains)
    (via_rule Mains)
    (rule
      (width 600.0)
    )
    (circuit 
      (use_layer F.Cu)
    )
  )
)