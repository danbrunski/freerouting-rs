
(rules PCB Issue153-wavefolder
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 6.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.2)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.2 (type Power))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_600:300_um-Power" "Via[0-1]_600:300_um" Power
  )
  (via 
    "Via[0-1]_800:400_um-Power" "Via[0-1]_800:400_um" Power
  )
  (viaRule
    default "Via[0-1]_600:300_um"
  )
  (viaRule
    default "Via[0-1]_600:300_um"
  )
  (viaRule
    Power "Via[0-1]_800:400_um-Power"
  )
  (class default
    "Net-(D1-Pad1)" "Net-(D1-Pad2)" "Net-(J1-PadT)" "unconnected-(J1-PadTN)" "Net-(J2-PadT)" "Net-(J3-PadT)" "Net-(Q1-Pad1)" "Net-(Q1-Pad2)"
    "Net-(Q1-Pad3)" "Net-(Q2-Pad1)" "Net-(Q2-Pad2)" "Net-(Q2-Pad3)" "Net-(Q3-Pad3)" "Net-(Q4-Pad1)" "Net-(Q4-Pad2)" "CV_CURRENT"
    "Net-(Q5-Pad1)" "Net-(Q6-Pad3)" "Net-(R18-Pad2)" "Net-(R21-Pad2)" "Net-(R5-Pad2)" "Net-(R10-Pad2)" "Net-(R6-Pad2)" "Net-(R12-Pad1)"
    "Net-(R11-Pad2)" "Net-(R19-Pad2)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power
    GND +12V "/+12V_RAW" "/-12V_RAW" "-12V"
    (clearance_class Power)
    (via_rule Power)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)