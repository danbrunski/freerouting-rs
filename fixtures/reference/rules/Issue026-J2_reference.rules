
(rules PCB Issue026-J2_reference
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.8)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.5)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (class default
    GND "/MIPI_CSI_D0_N" "/MIPI_CSI_CLK_N" "/MIPI_CSI_D0_P" "/MIPI_CSI_CLK_P" "/MIPI_CSI_D1_N" "Net-(J2-PadB5)" "/MIPI_CSI_D1_P"
    "Net-(J2-PadB6)" "/MIPI_CSI_MCLK" "Net-(J2-PadB8)" "/MIPI_CSI_CAM_nRST" "Net-(J2-PadB9)" "/I2C_SDA" "Net-(J2-PadB10)" "/I2C_SCL"
    "/MIPI_CSI_CAM_PWDN" "Net-(J2-PadA13)" +3V3 "Net-(J2-PadA14)" "Net-(J2-PadA16)" "Net-(J2-PadB16)" "Net-(J2-PadA17)" "Net-(J2-PadB17)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)