
(rules PCB Issue730-DAC2020_bm11
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule Top
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 2.8)
    )
    (layer_rule Route2
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule Route15
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
    (layer_rule Bottom
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.8)
      (against_preferred_direction_trace_costs 2.8)
    )
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle Top 600.0 0.0 0.0)
    )
    (shape
      (circle Route2 600.0 0.0 0.0)
    )
    (shape
      (circle Route15 600.0 0.0 0.0)
    )
    (shape
      (circle Bottom 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default
  )
  (viaRule
    default "Via[0-3]_600:300_um"
  )
  (viaRule
    default "Via[0-3]_600:300_um"
  )
  (class default
    "3V3" GND VBAT "BAT_GND" "Net-(B1-Pad3)" "Net-(B1-Pad4)" "Net-(C3-Pad1)" "Net-(C1-Pad1)"
    "Net-(C2-Pad1)" /PWM3 /PWM2 /PWM1 /TX0 /RX0 /PWM4 /MISO
    /MOSI /SCK /SDA /SCL "Net-(C4-Pad1)" /RESET "Net-(D1-PadA)" "Net-(C18-Pad1)"
    "Net-(C19-Pad1)" "Net-(B1-Pad2)" "Net-(B1-Pad1)" "Net-(D2-PadA)" "Net-(D3-PadA)" "Net-(D4-PadA)" /DTR "Net-(D7-Pad1)"
    "Net-(D8-Pad2)" /LED2 /LED1
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer Top Route2 Route15 Bottom)
    )
  )
)