
(rules PCB Issue155-CH376_MCP795_Module
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.3)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.8)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (viaRule
    default "Via[0-1]_800:400_um"
  )
  (class default
    /GND /VBAT "Net-(D0-Pad1)" /5V "/~{SD_SS}" "/SD_SCK" "/SD_MOSI" "/SD_MISO"
    "Net-(J1-Pad2)" "Net-(J1-Pad3)" /SCK /~{ACT} /MOSI /~{IRQ0} /MISO /~{IRQ1}
    /~{SS0} /~{IRQ2} /~{SS1} /CLKOUT "Net-(U0-Pad1)" "Net-(U0-Pad2)" "unconnected-(U1-Pad2)" "unconnected-(U1-Pad5)"
    "unconnected-(U1-Pad6)" "unconnected-(U1-Pad8)" /3V3 "Net-(U1-Pad13)" "Net-(U1-Pad14)" "unconnected-(U1-Pad15)" "unconnected-(U1-Pad16)" "unconnected-(U1-Pad17)"
    "unconnected-(U1-Pad21)" "unconnected-(U1-Pad27)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)