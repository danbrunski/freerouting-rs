    "Net-(IC12-PadP09)" "Net-(IC12-PadP08)" "Net-(IC12-PadP07)" "Net-(C72-Pad2)" "Net-(C70-Pad2)" "Net-(C69-Pad1)" "Net-(C69-Pad2)" "Net-(IC12-PadP15)"
    "Net-(IC12-PadP17)" "Net-(IC12-PadP18)" "Net-(IC12-PadP19)" "Net-(IC12-PadP20)" "Net-(IC12-PadP22)" "Net-(Q4-Pad1)" "Net-(D9-PadA)" "Net-(LED11-PadA)"
    "Net-(J13-Pad2)" "Net-(Q5-PadG)" "Net-(LED12-PadA)" "Net-(IC15-Pad7)" "/smoothieboard-5driver_4/VBBREG"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer Top Route15 Bottom)
    )
  )
)