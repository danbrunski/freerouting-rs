
(rules PCB Issue145-smoothieboard
  (snapAngle 
    fortyfive_degree
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    
    (layer_rule Top
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.6)
      (against_preferred_direction_trace_costs 2.8)
    )
    (layer_rule Route2
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.2)
    )
    (layer_rule Route15
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.8)
    )
    (layer_rule Bottom
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.6)
      (against_preferred_direction_trace_costs 2.8)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-3]_800:400_um"
    (shape
      (circle Top 800.0 0.0 0.0)
    )
    (shape
      (circle Route2 800.0 0.0 0.0)
    )
    (shape
      (circle Route15 800.0 0.0 0.0)
    )
    (shape
      (circle Bottom 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_800:400_um" "Via[0-3]_800:400_um" default
  )
  (viaRule
    default "Via[0-3]_800:400_um"
  )
  (viaRule
    default "Via[0-3]_800:400_um"
  )
  (class default
    AGND "3.3V" AVCC "ENET_TXD0" "ENET_TXD1" "ENET_TX_EN" "ENET_CRS" "ENET_RXD0"
    "ENET_RXD1" "ENET_RX_ER" "ENET_REF_CLK" "ENET_MDC" "ENET_MDIO" EN1 DIR1 STP1
    STP2 STP3 EN4 DIR4 STP4 TH1 TH2 TH3
    RSTOUT TH4 P2.6 P2.7 EN2 DIR2 EN3 DIR3
    PWM0 PWM1 "POT_SCL" "POT_SDA" "P1_22" "P1_23" VBB MS2
    MS1 "5V" "12VREG" EN5 STP5 DIR5 MS3 "/smoothieboard-5driver_1/JTAG-RTCK"
    "/smoothieboard-5driver_1/RX_0" "/smoothieboard-5driver_1/TX_0" "/smoothieboard-5driver_1/PLAY_LED" "/smoothieboard-5driver_1/SD_CS" "/smoothieboard-5driver_1/SD_SCK" "/smoothieboard-5driver_1/SD_MISO" "/smoothieboard-5driver_1/SD_MOSI" "/smoothieboard-5driver_1/Z_MAX"
    "/smoothieboard-5driver_1/Z_MIN" "/smoothieboard-5driver_1/Y_MAX" "/smoothieboard-5driver_1/Y_MIN" "/smoothieboard-5driver_1/X_MAX" "/smoothieboard-5driver_1/X_MIN" "/smoothieboard-5driver_1/LED4" "/smoothieboard-5driver_1/LED3" "/smoothieboard-5driver_1/LED2"
    "/smoothieboard-5driver_1/LED1" "/smoothieboard-5driver_1/USB_D-" "/smoothieboard-5driver_1/USB_D+" "/smoothieboard-5driver_1/SD_IRQ" "/smoothieboard-5driver_1/SD_WP" "/smoothieboard-5driver_1/SDA" "/smoothieboard-5driver_1/SCL" "Net-(C3-Pad1)"
    "Net-(C2-Pad1)" "/smoothieboard-5driver_1/P1_30" "/smoothieboard-5driver_1/P1_31" "Net-(IC1-Pad18)" "/smoothieboard-5driver_1/RESET" "Net-(IC1-Pad16)" "Net-(IC1-Pad13)" "/smoothieboard-5driver_1/JTAG-TCK"
    "/smoothieboard-5driver_1/JTAG-TRST" "/smoothieboard-5driver_1/JTAG-TMS" "/smoothieboard-5driver_1/JTAG-TDI" "/smoothieboard-5driver_1/JTAG-TDO" "/smoothieboard-5driver_1/PLAY" "/smoothieboard-5driver_1/SD_CD" "/smoothieboard-5driver_1/ISP_BOOT" "/smoothieboard-5driver_1/MOSI1"
