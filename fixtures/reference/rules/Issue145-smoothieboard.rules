    "Net-(IC5-PadP15)" "Net-(IC5-PadP17)" "Net-(IC5-PadP18)" "Net-(IC5-PadP19)" "Net-(IC5-PadP20)" "Net-(IC5-PadP22)" "/smoothieboard-5driver_2/P3W" "Net-(IC6-PadP09)"
    "Net-(IC6-PadP08)" "Net-(IC6-PadP07)" "Net-(C33-Pad2)" "Net-(C35-Pad2)" "Net-(C37-Pad1)" "Net-(C37-Pad2)" "Net-(IC6-PadP15)" "Net-(IC6-PadP17)"
