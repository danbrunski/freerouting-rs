(session "scoring-mixed-layer"
  (base_design "scoring-mixed-layer")
  (placement
    (resolution um 10)
    (component "PAD_F"
      (place U1 20000.0 20000.0 front 0)
    )
    (component "PAD_B"
      (place U2 80000.0 80000.0 front 0)
    )
  )
  (was_is
  )
  (routes 
    (resolution um 10)
    (parser
    )
    (library_out 
      (padstack "Via[0-1]_800:400_um"
