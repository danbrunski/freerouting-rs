        (wire
          (path F.Cu 2500
            20000 20000
            82700 20000
          )
        )
        (wire
          (path B.Cu 2500
            80000 80000
            82700 77300
            82700 20000
          )
        )
        (via "Via[0-1]_800:400_um" 82700.0 20000.0
        )
      )
    )
  )
)