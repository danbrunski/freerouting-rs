    )
    (component syn:Copper
      (place C1 150000 -100000 front 0 (PN copper))
    )
  )
  (library
    (image syn:Area
      (pin Rect[T]Pad_1500.000000x1500.000000_um 1 0 0)
      (keepout "" (polygon F.Cu 0  3000 4000  9000 4000  9000 -4000  3000 -4000  3000 4000))
    )
    (image syn:Area::1
