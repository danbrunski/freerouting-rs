  (placement
    (component syn:Area
      (place A0 30000 -100000 front 0 (PN area))
      (place B0 30000 -125000 back 0 (PN area))
    )
    (component syn:Area::1
      (place A135 90000 -100000 front 135 (PN area))
      (place B135 90000 -125000 back 225 (PN area))
    )
    (component syn:Area::2
      (place A30 60000 -100000 front 30 (PN area))
      (place B30 60000 -125000 back 330 (PN area))
    )
    (component syn:Two
