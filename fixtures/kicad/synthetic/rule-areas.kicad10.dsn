    (net @:no_net_1
    )
    (net @:no_net_2
    )
    (net N1
      (pins A0-1 A135-1 A30-1 U1-1 B135-1 B0-1 B30-1)
    )
    (net N2
      (pins U1-2 C1-1)
    )
    (class kicad_default N1 N2
