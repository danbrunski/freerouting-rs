(pcb "min_fr_test.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.7-10.0.7~ubuntu24.04.1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer In1.Cu
      (type power)
      (property
        (index 1)
      )
    )
    (layer In2.Cu
      (type power)
      (property
        (index 2)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 3)
      )
    )
    (boundary
      (path pcb 0  179000 -101000  149000 -101000  149000 -79000  179000 -79000
            179000 -101000)
    )
    (plane GND (polygon In2.Cu 0  150000 -80000  178000 -80000  178000 -100000  150000 -100000
            150000 -80000))
    (via "Via[0-3]_600:300_um")
    (rule
      (width 200)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component TestPoint:TestPoint_Pad_1.0x1.0mm
      (place J4 162900 -92000 front 0 (PN Conn_01x01_Pin))
      (place J8 171000 -90000 front 0 (PN Conn_01x01_Pin))
      (place J7 159000 -85000 front 0 (PN Conn_01x01_Pin))
      (place J1 155000 -85000 front 0 (PN Conn_01x01_Pin))
    )
  )
  (library
    (image TestPoint:TestPoint_Pad_1.0x1.0mm
      (outline (polygon signal 0  995 -995  -995 -995  -995 995  995 995))
      (outline (path signal 120  -700 700  700 700))
      (outline (path signal 120  -700 -700  -700 700))
      (outline (path signal 120  700 700  700 -700))
      (outline (path signal 120  700 -700  -700 -700))
      (pin Rect[T]Pad_1000.000000x1000.000000_um 1 0 0)
    )
    (padstack Rect[T]Pad_1000.000000x1000.000000_um
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack "Via[0-3]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle In1.Cu 600))
      (shape (circle In2.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net "Net-(J1-Pin_1)"
      (pins J8-1 J1-1)
    )
    (net GND
      (pins J4-1 J7-1)
    )
    (class kicad_default GND "Net-(J1-Pin_1)"
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
