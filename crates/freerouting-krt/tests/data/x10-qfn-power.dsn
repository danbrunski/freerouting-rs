(pcb x10-qfn-power.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "freerouting-rs X10 synthetic fixture")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer In1.Cu
      (type power)
      (property
        (index 1)
      )
    )
    (layer In2.Cu
      (type signal)
      (property
        (index 2)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 3)
      )
    )
    (boundary
      (path pcb 0  0 0  40000 0  40000 40000  0 40000  0 0)
    )
    (plane GND (polygon In1.Cu 0  500 500  39500 500  39500 39500  500 39500))
    (via VIA600)
    (rule
      (width 200)
      (clearance 200)
    )
  )
  (placement
    (component QFN24
      (place U1 20000 20000 front 0)
    )
    (component HDR22
      (place H1 6000 4000 front 0)
    )
    (component BIG_PAD
      (place J1 20000 34000 front 0)
    )
  )
  (library
    (image QFN24
      (outline (path signal 120  -2100 -2100  2100 -2100  2100 2100  -2100 2100  -2100 -2100))
      (pin QFN_PAD_H 1 -2000 1250)
      (pin QFN_PAD_H 2 -2000 750)
      (pin QFN_PAD_H 3 -2000 250)
      (pin QFN_PAD_H 4 -2000 -250)
      (pin QFN_PAD_H 5 -2000 -750)
      (pin QFN_PAD_H 6 -2000 -1250)
      (pin QFN_PAD_V 7 -1250 -2000)
      (pin QFN_PAD_V 8 -750 -2000)
      (pin QFN_PAD_V 9 -250 -2000)
      (pin QFN_PAD_V 10 250 -2000)
      (pin QFN_PAD_V 11 750 -2000)
      (pin QFN_PAD_V 12 1250 -2000)
      (pin QFN_PAD_H 13 2000 -1250)
      (pin QFN_PAD_H 14 2000 -750)
      (pin QFN_PAD_H 15 2000 -250)
      (pin QFN_PAD_H 16 2000 250)
      (pin QFN_PAD_H 17 2000 750)
      (pin QFN_PAD_H 18 2000 1250)
      (pin QFN_PAD_V 19 1250 2000)
      (pin QFN_PAD_V 20 750 2000)
      (pin QFN_PAD_V 21 250 2000)
      (pin QFN_PAD_V 22 -250 2000)
      (pin QFN_PAD_V 23 -750 2000)
      (pin QFN_PAD_V 24 -1250 2000)
      (pin QFN_EP 25 0 0)
    )
    (image HDR22
      (pin HDR 1 0 0)
      (pin HDR 2 1270 0)
      (pin HDR 3 2540 0)
      (pin HDR 4 3810 0)
      (pin HDR 5 5080 0)
      (pin HDR 6 6350 0)
      (pin HDR 7 7620 0)
      (pin HDR 8 8890 0)
      (pin HDR 9 10160 0)
      (pin HDR 10 11430 0)
      (pin HDR 11 12700 0)
      (pin HDR 12 13970 0)
      (pin HDR 13 15240 0)
      (pin HDR 14 16510 0)
      (pin HDR 15 17780 0)
      (pin HDR 16 19050 0)
      (pin HDR 17 20320 0)
      (pin HDR 18 21590 0)
      (pin HDR 19 22860 0)
      (pin HDR 20 24130 0)
      (pin HDR 21 25400 0)
      (pin HDR 22 26670 0)
    )
    (image BIG_PAD
      (pin BIG 1 0 0)
    )
    (padstack QFN_PAD_H
      (shape (rect F.Cu -400 -125 400 125))
      (attach off)
    )
    (padstack QFN_PAD_V
      (shape (rect F.Cu -125 -400 125 400))
      (attach off)
    )
    (padstack QFN_EP
      (shape (rect F.Cu -1250 -1250 1250 1250))
      (attach off)
    )
    (padstack BALL
      (shape (circle F.Cu 300))
      (attach off)
    )
    (padstack SO_PAD
      (shape (rect F.Cu -750 -200 750 200))
      (attach off)
    )
    (padstack TS_PAD
      (shape (rect F.Cu -600 -175 600 175))
      (attach off)
    )
    (padstack HDR
      (shape (circle F.Cu 800))
      (attach off)
    )
    (padstack BIG
      (shape (circle F.Cu 2000))
      (attach off)
    )
    (padstack VIA600
      (shape (circle F.Cu 600))
      (shape (circle In1.Cu 600))
      (shape (circle In2.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net S1 (pins U1-1 H1-1))
    (net S2 (pins U1-2 H1-2))
    (net PWR (pins U1-3 J1-1))
    (net S4 (pins U1-4 H1-3))
    (net S5 (pins U1-5 H1-4))
    (net S6 (pins U1-6 H1-5))
    (net S7 (pins U1-7 H1-6))
    (net S8 (pins U1-8 H1-7))
    (net S9 (pins U1-9 H1-8))
    (net GND (pins U1-10))
    (net S11 (pins U1-11 H1-9))
    (net S12 (pins U1-12 H1-10))
    (net S13 (pins U1-13 H1-11))
    (net S14 (pins U1-14 H1-12))
    (net S15 (pins U1-15 H1-13))
    (net S16 (pins U1-16 H1-14))
    (net S17 (pins U1-17 H1-15))
    (net S18 (pins U1-18 H1-16))
    (net S19 (pins U1-19 H1-17))
    (net NC20 (pins U1-20))
    (net S21 (pins U1-21 H1-18))
    (net S22 (pins U1-22 H1-19))
    (net S23 (pins U1-23 H1-20))
    (net S24 (pins U1-24 H1-21))
    (class kicad_default S1 S2 S4 S5 S6 S7 S8 S9 GND S11 S12 S13 S14 S15 S16 S17 S18 S19 NC20 S21 S22 S23 S24
      (circuit
        (use_via VIA600)
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
    (class Power_High PWR
      (circuit
        (use_via VIA600)
      )
      (rule
        (width 1500)
        (clearance 250)
      )
    )
  )
)
