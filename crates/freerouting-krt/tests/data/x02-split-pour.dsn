(pcb x02-split-pour.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "synthetic X02.4 fixture: a GND pour on B.Cu cut in two by a pre-routed trace of net S, with room for a strap around the trace's upper end")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary
      (path pcb 0  0 0  40000 0  40000 35000  0 35000  0 0)
    )
    (plane GND (polygon B.Cu 0  10000 5000  30000 5000  30000 25000  10000 25000))
    (via "Via[0-1]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
    )
  )
  (placement
    (component "TH"
      (place G1 13000 10000 front 0)
      (place G2 13000 20000 front 0)
      (place G3 27000 15000 front 0)
      (place S1 20000 1000 front 0)
      (place S2 20000 27000 front 0)
      (place A1 5000 5000 front 0)
      (place A2 5000 25000 front 0)
    )
  )
  (library
    (image "TH"
      (pin Th 1 0 0)
    )
    (padstack Th
      (shape (circle F.Cu 1000))
      (shape (circle B.Cu 1000))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net GND (pins G1-1 G2-1 G3-1))
    (net S (pins S1-1 S2-1))
    (net A (pins A1-1 A2-1))
    (class kicad_default "" A GND S
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
  )
  (wiring
    (wire (path B.Cu 500  20000 1000  20000 27000) (net S) (type route))
  )
)
