(pcb x06-regions.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "synthetic X06 fixture: a 32-pin 0.5 mm pitch QFN (U1), a 32-pin 0.8 mm pitch QFP with 0.45 mm pads (U2), a 3-pin 2.54 mm header (J1) and two 0603-size resistors (R1, R2)")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary
      (path pcb 0  0 0  60000 0  60000 40000  0 40000  0 0)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 127)
      (clearance 127)
    )
  )
  (placement
    (component "QFN32"
      (place U1 15000 20000 front 0)
    )
    (component "QFP32"
      (place U2 42000 20000 front 0)
    )
    (component "HDR3"
      (place J1 28000 34000 front 0)
    )
    (component "R0603"
      (place R1 10000 5000 front 0)
      (place R2 50000 5000 front 0)
    )
  )
  (library
    (image "QFN32"
      (pin QfnH 1 -2500 1750)
      (pin QfnH 2 -2500 1250)
      (pin QfnH 3 -2500 750)
      (pin QfnH 4 -2500 250)
      (pin QfnH 5 -2500 -250)
      (pin QfnH 6 -2500 -750)
      (pin QfnH 7 -2500 -1250)
      (pin QfnH 8 -2500 -1750)
      (pin QfnV 9 -1750 -2500)
      (pin QfnV 10 -1250 -2500)
      (pin QfnV 11 -750 -2500)
      (pin QfnV 12 -250 -2500)
      (pin QfnV 13 250 -2500)
      (pin QfnV 14 750 -2500)
      (pin QfnV 15 1250 -2500)
      (pin QfnV 16 1750 -2500)
      (pin QfnH 17 2500 -1750)
      (pin QfnH 18 2500 -1250)
      (pin QfnH 19 2500 -750)
      (pin QfnH 20 2500 -250)
      (pin QfnH 21 2500 250)
      (pin QfnH 22 2500 750)
      (pin QfnH 23 2500 1250)
      (pin QfnH 24 2500 1750)
      (pin QfnV 25 1750 2500)
      (pin QfnV 26 1250 2500)
      (pin QfnV 27 750 2500)
      (pin QfnV 28 250 2500)
      (pin QfnV 29 -250 2500)
      (pin QfnV 30 -750 2500)
      (pin QfnV 31 -1250 2500)
      (pin QfnV 32 -1750 2500)
    )
    (image "QFP32"
      (pin QfpH 1 -4500 2800)
      (pin QfpH 2 -4500 2000)
      (pin QfpH 3 -4500 1200)
      (pin QfpH 4 -4500 400)
      (pin QfpH 5 -4500 -400)
      (pin QfpH 6 -4500 -1200)
      (pin QfpH 7 -4500 -2000)
      (pin QfpH 8 -4500 -2800)
      (pin QfpV 9 -2800 -4500)
      (pin QfpV 10 -2000 -4500)
      (pin QfpV 11 -1200 -4500)
      (pin QfpV 12 -400 -4500)
      (pin QfpV 13 400 -4500)
      (pin QfpV 14 1200 -4500)
      (pin QfpV 15 2000 -4500)
      (pin QfpV 16 2800 -4500)
      (pin QfpH 17 4500 -2800)
      (pin QfpH 18 4500 -2000)
      (pin QfpH 19 4500 -1200)
      (pin QfpH 20 4500 -400)
      (pin QfpH 21 4500 400)
      (pin QfpH 22 4500 1200)
      (pin QfpH 23 4500 2000)
      (pin QfpH 24 4500 2800)
      (pin QfpV 25 2800 4500)
      (pin QfpV 26 2000 4500)
      (pin QfpV 27 1200 4500)
      (pin QfpV 28 400 4500)
      (pin QfpV 29 -400 4500)
      (pin QfpV 30 -1200 4500)
      (pin QfpV 31 -2000 4500)
      (pin QfpV 32 -2800 4500)
    )
    (image "HDR3"
      (pin Hdr 1 -2540 0)
      (pin Hdr 2 0 0)
      (pin Hdr 3 2540 0)
    )
    (image "R0603"
      (pin Rp 1 -800 0)
      (pin Rp 2 800 0)
    )
    (padstack QfnH
      (shape (rect F.Cu -400 -125 400 125))
      (attach off)
    )
    (padstack QfnV
      (shape (rect F.Cu -125 -400 125 400))
      (attach off)
    )
    (padstack QfpH
      (shape (rect F.Cu -750 -225 750 225))
      (attach off)
    )
    (padstack QfpV
      (shape (rect F.Cu -225 -750 225 750))
      (attach off)
    )
    (padstack Hdr
      (shape (rect F.Cu -850 -850 850 850))
      (attach off)
    )
    (padstack Rp
      (shape (rect F.Cu -450 -475 450 475))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net Q (pins U1-1 J1-1))
    (net L (pins U2-1 J1-3))
    (net O (pins R1-1 R2-1))
    (class kicad_default "" Q L O
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 127) (clearance 127))
    )
  )
  (wiring
  )
)
