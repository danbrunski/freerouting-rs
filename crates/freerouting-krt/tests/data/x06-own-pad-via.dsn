(pcb x06-own-pad-via.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "synthetic X06 fixture: net A from an F.Cu SMD pad P1 to a B.Cu SMD pad P2; a keepout closes F.Cu 1.2 mm past P1's edge, so the via must stand right beside P1 and keep its clearance from it (attach off)")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary
      (path pcb 0  0 0  30000 0  30000 20000  0 20000  0 0)
    )
    (keepout "" (rect F.Cu 11700 0 30000 20000))
    (via "Via[0-1]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
    )
  )
  (placement
    (component "SMDF"
      (place P1 10000 10000 front 0)
    )
    (component "SMDB"
      (place P2 20000 10000 front 0)
    )
  )
  (library
    (image "SMDF"
      (pin PadF 1 0 0)
    )
    (image "SMDB"
      (pin PadB 1 0 0)
    )
    (padstack PadF
      (shape (rect F.Cu -500 -300 500 300))
      (attach off)
    )
    (padstack PadB
      (shape (rect B.Cu -500 -300 500 300))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net A (pins P1-1 P2-1))
    (class kicad_default "" A
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
  )
  (wiring
  )
)
