(pcb x05-wall.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "synthetic X05 fixture: net A from P1 to P2 is cut off by a wall of net W on both layers, from board edge to board edge")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary
      (path pcb 0  0 0  40000 0  40000 30000  0 30000  0 0)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
    )
  )
  (placement
    (component "SMD"
      (place P1 10050 15050 front 0)
      (place P2 30000 15000 front 0)
      (place W1 20000 1000 front 0)
      (place W2 20000 29000 front 0)
    )
  )
  (library
    (image "SMD"
      (pin Pad 1 0 0)
    )
    (padstack Pad
      (shape (rect F.Cu -500 -300 500 300))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net A (pins P1-1 P2-1))
    (net W (pins W1-1 W2-1))
    (class kicad_default "" A W
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
  )
  (wiring
    (wire (path F.Cu 500  20000 300  20000 29700) (net W) (type route))
    (wire (path B.Cu 500  20000 300  20000 29700) (net W) (type route))
  )
)
