(pcb x10-frame.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "freerouting-rs X10 synthetic fixture")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer In1.Cu
      (type power)
      (property
        (index 1)
      )
    )
    (layer In2.Cu
      (type signal)
      (property
        (index 2)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 3)
      )
    )
    (boundary
      (path pcb 0  0 0  50000 0  50000 50000  0 50000  0 0)
    )
    (via VIA600)
    (rule
      (width 200)
      (clearance 200)
    )
  )
  (placement
    (component QFN24
      (place U1 10000 10000 front 0)
      (place U2 25000 10000 front 90)
      (place U3 10000 25000 front 37)
      (place U4 25000 25000 back 0)
      (place U5 25000 40000 back 127)
    )
    (component BGA25
      (place B1 40000 10000 front 0)
    )
    (component SOIC8
      (place S1 40000 25000 front 0)
    )
    (component TSSOP8
      (place T1 40000 40000 front 0)
    )
  )
  (library
    (image QFN24
      (outline (path signal 120  -2100 -2100  2100 -2100  2100 2100  -2100 2100  -2100 -2100))
      (pin QFN_PAD_H 1 -2000 1250)
      (pin QFN_PAD_H 2 -2000 750)
      (pin QFN_PAD_H 3 -2000 250)
      (pin QFN_PAD_H 4 -2000 -250)
      (pin QFN_PAD_H 5 -2000 -750)
      (pin QFN_PAD_H 6 -2000 -1250)
      (pin QFN_PAD_V 7 -1250 -2000)
      (pin QFN_PAD_V 8 -750 -2000)
      (pin QFN_PAD_V 9 -250 -2000)
      (pin QFN_PAD_V 10 250 -2000)
      (pin QFN_PAD_V 11 750 -2000)
      (pin QFN_PAD_V 12 1250 -2000)
      (pin QFN_PAD_H 13 2000 -1250)
      (pin QFN_PAD_H 14 2000 -750)
      (pin QFN_PAD_H 15 2000 -250)
      (pin QFN_PAD_H 16 2000 250)
      (pin QFN_PAD_H 17 2000 750)
      (pin QFN_PAD_H 18 2000 1250)
      (pin QFN_PAD_V 19 1250 2000)
      (pin QFN_PAD_V 20 750 2000)
      (pin QFN_PAD_V 21 250 2000)
      (pin QFN_PAD_V 22 -250 2000)
      (pin QFN_PAD_V 23 -750 2000)
      (pin QFN_PAD_V 24 -1250 2000)
      (pin QFN_EP 25 0 0)
    )
    (image BGA25
      (pin BALL A1 -1000 1000)
      (pin BALL A2 -500 1000)
      (pin BALL A3 0 1000)
      (pin BALL A4 500 1000)
      (pin BALL A5 1000 1000)
      (pin BALL B1 -1000 500)
      (pin BALL B2 -500 500)
      (pin BALL B3 0 500)
      (pin BALL B4 500 500)
      (pin BALL B5 1000 500)
      (pin BALL C1 -1000 0)
      (pin BALL C2 -500 0)
      (pin BALL C3 0 0)
      (pin BALL C4 500 0)
      (pin BALL C5 1000 0)
      (pin BALL D1 -1000 -500)
      (pin BALL D2 -500 -500)
      (pin BALL D3 0 -500)
      (pin BALL D4 500 -500)
      (pin BALL D5 1000 -500)
      (pin BALL E1 -1000 -1000)
      (pin BALL E2 -500 -1000)
      (pin BALL E3 0 -1000)
      (pin BALL E4 500 -1000)
      (pin BALL E5 1000 -1000)
    )
    (image SOIC8
      (pin SO_PAD 1 -2700 1905)
      (pin SO_PAD 2 -2700 635)
      (pin SO_PAD 3 -2700 -635)
      (pin SO_PAD 4 -2700 -1905)
      (pin SO_PAD 5 2700 -1905)
      (pin SO_PAD 6 2700 -635)
      (pin SO_PAD 7 2700 635)
      (pin SO_PAD 8 2700 1905)
    )
    (image TSSOP8
      (pin TS_PAD 1 -2900 975)
      (pin TS_PAD 2 -2900 325)
      (pin TS_PAD 3 -2900 -325)
      (pin TS_PAD 4 -2900 -975)
      (pin TS_PAD 5 2900 -975)
      (pin TS_PAD 6 2900 -325)
      (pin TS_PAD 7 2900 325)
      (pin TS_PAD 8 2900 975)
    )
    (padstack QFN_PAD_H
      (shape (rect F.Cu -400 -125 400 125))
      (attach off)
    )
    (padstack QFN_PAD_V
      (shape (rect F.Cu -125 -400 125 400))
      (attach off)
    )
    (padstack QFN_EP
      (shape (rect F.Cu -1250 -1250 1250 1250))
      (attach off)
    )
    (padstack BALL
      (shape (circle F.Cu 300))
      (attach off)
    )
    (padstack SO_PAD
      (shape (rect F.Cu -750 -200 750 200))
      (attach off)
    )
    (padstack TS_PAD
      (shape (rect F.Cu -600 -175 600 175))
      (attach off)
    )
    (padstack HDR
      (shape (circle F.Cu 800))
      (attach off)
    )
    (padstack BIG
      (shape (circle F.Cu 2000))
      (attach off)
    )
    (padstack VIA600
      (shape (circle F.Cu 600))
      (shape (circle In1.Cu 600))
      (shape (circle In2.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net A (pins U1-1 U2-1))
    (class kicad_default A
      (circuit
        (use_via VIA600)
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
)
