(pcb pin-swap.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (boundary
      (path pcb 0  0 0  20000 0  20000 10000  0 10000  0 0)
    )
    (rule
      (width 250)
      (clearance 200)
    )
  )
  (placement
    (component QUAD
      (place U1 5000 5000 front 0)
    )
    (component PAD
      (place J1 15000 2000 front 0)
      (place J2 15000 4000 front 0)
      (place J3 15000 6000 front 0)
    )
  )
  (library
    (image QUAD
      (pin CirclePad_F_800_um 1 -1500 0)
      (pin CirclePad_F_800_um 2 -500 0)
      (pin CirclePad_F_800_um 3 500 0)
      (pin CirclePad_F_800_um 4 1500 0)
    )
    (image PAD
      (pin CirclePad_F_800_um 1 0 0)
    )
    (padstack CirclePad_F_800_um
      (shape (circle F.Cu 800))
      (attach off)
    )
  )
  (part_library
    (logical_part_mapping QUADPART
      (component U1)
    )
    (logical_part QUADPART
      (pin 1 1 A 0 in1 1)
      (pin 2 2 A 0 in2 1)
      (pin 3 3 A 0 out 2)
      (pin 4 4 B 0 in1 1)
    )
  )
  (network
    (net NA (pins U1-1 J1-1))
    (net NB (pins U1-2 J2-1))
    (net NC (pins U1-3 J3-1))
    (class kicad_default NA NB NC
    )
  )
)
