(kicad_pcb (version 20240108) (generator "pcbnew") (generator_version "8.0")
  (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (38 "B.Mask" user) (39 "F.Mask" user) (44 "Edge.Cuts" user))
  (setup (pad_to_mask_clearance 0.05))
  (net 0 "")
  (net 1 "SIG")
  (net 2 "CLK")
  (gr_rect (start 0 0) (end 30 20) (stroke (width 0.05) (type solid)) (fill none) (layer "Edge.Cuts"))
  (footprint "l:pad" (layer "F.Cu") (at 3 10)
    (property "Reference" "P1") (property "Value" "x")
    (pad "1" smd rect (at 0 0) (size 0.6 0.6) (layers "F.Cu" "F.Mask") (net 1 "SIG")))
  (footprint "l:pad" (layer "F.Cu") (at 27 10)
    (property "Reference" "P2") (property "Value" "x")
    (pad "1" smd rect (at 0 0) (size 0.6 0.6) (layers "F.Cu" "F.Mask") (net 1 "SIG")))
  (footprint "l:tp" (layer "F.Cu") (at 15 10.7)
    (property "Reference" "TP1") (property "Value" "x")
    (pad "1" smd circle (at 0 0) (size 0.8 0.8) (layers "F.Cu" "F.Mask") (net 2 "CLK")
      (solder_mask_margin 0.5)))
)
