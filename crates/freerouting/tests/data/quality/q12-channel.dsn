(pcb q12-channel.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "freerouting-rs Q12 synthetic fixture")
    (host_version "one layer; a one-trace channel joins two rooms, with a wide bridge above. B's pads sit in notches off the channel, so B routes only through it; A routes through it (short) or over the bridge (long). With the fanout off, pass 1 routes A first through the channel and B fails; B first leaves both complete (Q12.2)")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (boundary
      (path pcb 0  0 0  20000 0  20000 10000  0 10000  0 0)
    )
    (keepout "" (polygon signal 0  8000 0  12000 0  12000 4650  8000 4650))
    (keepout "" (polygon signal 0  8000 5350  8300 5350  8300 6000  8900 6000  8900 5350  11100 5350  11100 6000  11700 6000  11700 5350  12000 5350  12000 9000  8000 9000))
    (via "Via[0-0]_600:300_um")
    (rule
      (width 200)
      (clearance 150)
    )
  )
  (placement
    (component "PAD"
      (place B1 8600 5650 front 0)
      (place B2 11400 5650 front 0)
      (place A1 2000 5000 front 0)
      (place A2 18000 5000 front 0)
    )
  )
  (library
    (image "PAD"
      (pin RectPad 1 0 0)
    )
    (padstack RectPad
      (shape (rect F.Cu -200 -200 200 200))
      (attach off)
    )
    (padstack "Via[0-0]_600:300_um"
      (shape (circle F.Cu 600))
      (attach off)
    )
  )
  (network
    (net B (pins B1-1 B2-1))
    (net A (pins A1-1 A2-1))
    (class kicad_default "" A B
      (circuit (use_via "Via[0-0]_600:300_um"))
      (rule (width 200) (clearance 150))
    )
  )
  (wiring)
)
