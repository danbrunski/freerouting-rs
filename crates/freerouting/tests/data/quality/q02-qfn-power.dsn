(pcb q02-qfn-power.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "freerouting-rs Q17 synthetic fixture")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  0 0  40000 0  40000 30000  0 30000  0 0)
    )
    (via VIA600)
    (rule
      (width 200)
      (clearance 200)
    )
  )
  (placement
    (component QFN28
      (place U1 12000 15000 front 0)
    )
    (component BIG_PAD
      (place J1 32000 5000 front 0)
    )
  )
  (library
    (image QFN28
      (outline (path signal 0  -3400 -3400  3400 -3400  3400 3400  -3400 3400  -3400 -3400))
      (pin QFN_V 1 -1500 -2000)
      (pin QFN_V 2 -500 -2000)
      (pin QFN_V 3 500 -2000)
      (pin QFN_V 4 1500 -2000)
      (pin QFN_V 5 -2000 -2800)
      (pin QFN_V 6 -1000 -2800)
      (pin QFN_V 7 0 -2800)
      (pin QFN_V 8 1000 -2800)
      (pin QFN_V 9 2000 -2800)
      (pin QFN_H 10 2600 -1500)
      (pin QFN_H 11 2600 -1000)
      (pin QFN_H 12 2600 -500)
      (pin QFN_H 13 2600 0)
      (pin QFN_H 14 2600 500)
      (pin QFN_H 15 2600 1000)
      (pin QFN_H 16 2600 1500)
      (pin QFN_V 17 1500 2400)
      (pin QFN_V 18 1000 2400)
      (pin QFN_V 19 500 2400)
      (pin QFN_V 20 0 2400)
      (pin QFN_V 21 -500 2400)
      (pin QFN_V 22 -1000 2400)
      (pin QFN_V 23 -1500 2400)
      (pin QFN_H 24 -2600 1500)
      (pin QFN_H 25 -2600 1000)
      (pin QFN_H 26 -2600 500)
      (pin QFN_H 27 -2600 0)
      (pin QFN_H 28 -2600 -500)
      (pin QFN_H 29 -2600 -1000)
      (pin QFN_H 30 -2600 -1500)
      (pin QFN_EP 31 0 0)
    )
    (image BIG_PAD
      (pin BIG 1 0 0)
    )
    (padstack QFN_V
      (shape (rect F.Cu -125 -250 125 250))
      (attach off)
    )
    (padstack QFN_H
      (shape (rect F.Cu -400 -125 400 125))
      (attach off)
    )
    (padstack QFN_EP
      (shape (rect F.Cu -1200 -1200 1200 1200))
      (attach off)
    )
    (padstack BIG
      (shape (circle F.Cu 2000))
      (attach off)
    )
    (padstack VIA600
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net PWR (pins U1-2 J1-1))
    (net N1 (pins U1-1))
    (net N3 (pins U1-3))
    (net N4 (pins U1-4))
    (net N5 (pins U1-5))
    (net N6 (pins U1-6))
    (net N7 (pins U1-7))
    (net N8 (pins U1-8))
    (net N9 (pins U1-9))
    (net N10 (pins U1-10))
    (net N11 (pins U1-11))
    (net N12 (pins U1-12))
    (net N13 (pins U1-13))
    (net N14 (pins U1-14))
    (net N15 (pins U1-15))
    (net N16 (pins U1-16))
    (net N17 (pins U1-17))
    (net N18 (pins U1-18))
    (net N19 (pins U1-19))
    (net N20 (pins U1-20))
    (net N21 (pins U1-21))
    (net N22 (pins U1-22))
    (net N23 (pins U1-23))
    (net N24 (pins U1-24))
    (net N25 (pins U1-25))
    (net N26 (pins U1-26))
    (net N27 (pins U1-27))
    (net N28 (pins U1-28))
    (net N29 (pins U1-29))
    (net N30 (pins U1-30))
    (net N31 (pins U1-31))
    (class kicad_default N1 N3 N4 N5 N6 N7 N8 N9 N10 N11 N12 N13 N14 N15 N16 N17 N18 N19 N20 N21 N22 N23 N24 N25 N26 N27 N28 N29 N30 N31
      (circuit
        (use_via VIA600)
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
    (class Power_High PWR
      (circuit
        (use_via VIA600)
      )
      (rule
        (width 1500)
        (clearance 250)
      )
    )
  )
)
