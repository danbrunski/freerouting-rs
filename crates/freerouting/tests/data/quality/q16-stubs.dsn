(pcb q16-stubs.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "synthetic Q16 fixture: one net per stub-cleanup case, the wiring as the router could leave it")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer In1.Cu (type power) (property (index 1)))
    (layer B.Cu (type signal) (property (index 2)))
    (boundary
      (path pcb 0  0 0  60000 0  60000 -50000  0 -50000  0 0)
    )
    (plane GND (polygon In1.Cu 0  1000 -32000  59000 -32000  59000 -49000  1000 -49000))
    (via "Via[0-2]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
    )
  )
  (placement
    (component "SMD"
      (place A1 5000 -4000 front 0)
      (place B1 50000 -4000 front 0)
      (place A2 5000 -10000 front 0)
      (place B2 50000 -10000 front 0)
      (place A3 5000 -16000 front 0)
      (place B3 50000 -16000 front 0)
      (place A4 5000 -22000 front 0)
      (place B4 50000 -22000 front 0)
      (place A5 5000 -28000 front 0)
      (place B5 50000 -28000 front 0)
      (place G1 5000 -40000 front 0)
      (place G2 50000 -40000 front 0)
    )
  )
  (library
    (image "SMD"
      (pin RectPad 1 0 0)
    )
    (padstack RectPad
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack "Via[0-2]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle In1.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net FAILED (pins A1-1 B1-1))
    (net CHAIN (pins A2-1 B2-1))
    (net DONE (pins A3-1 B3-1))
    (net FIXED (pins A4-1 B4-1))
    (net ONE_LAYER (pins A5-1 B5-1))
    (net GND (pins G1-1 G2-1))
    (class kicad_default "" FAILED CHAIN DONE FIXED ONE_LAYER GND
      (circuit (use_via "Via[0-2]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
  )
  (wiring
    (wire (path F.Cu 250  5000 -4000  15000 -4000) (net FAILED))
    (via "Via[0-2]_600:300_um" 15000 -4000 (net FAILED))
    (wire (path B.Cu 250  15000 -4000  30000 -4000) (net FAILED))
    (via "Via[0-2]_600:300_um" 30000 -4000 (net FAILED))
    (wire (path F.Cu 250  30000 -4000  40000 -4000) (net FAILED))
    (wire (path F.Cu 250  5000 -10000  15000 -10000) (net CHAIN))
    (wire (path F.Cu 300  15000 -10000  18000 -13000) (net CHAIN))
    (wire (path F.Cu 350  18000 -13000  28000 -13000) (net CHAIN))
    (wire (path F.Cu 250  5000 -16000  15000 -16000) (net DONE))
    (via "Via[0-2]_600:300_um" 15000 -16000 (net DONE))
    (wire (path B.Cu 250  15000 -16000  40000 -16000) (net DONE))
    (via "Via[0-2]_600:300_um" 40000 -16000 (net DONE))
    (wire (path F.Cu 250  40000 -16000  50000 -16000) (net DONE))
    (via "Via[0-2]_600:300_um" 20000 -22000 (net FIXED) (type fix))
    (wire (path F.Cu 250  20000 -22000  30000 -22000) (net FIXED) (type protect))
    (via "Via[0-2]_600:300_um" 40000 -22000 (net FIXED))
    (wire (path F.Cu 250  5000 -28000  25000 -28000) (net ONE_LAYER))
    (via "Via[0-2]_600:300_um" 25000 -28000 (net ONE_LAYER))
    (wire (path F.Cu 300  25000 -28000  50000 -28000) (net ONE_LAYER))
    (wire (path F.Cu 250  5000 -40000  10000 -40000) (net GND))
    (via "Via[0-2]_600:300_um" 10000 -40000 (net GND))
    (wire (path F.Cu 250  50000 -40000  45000 -40000) (net GND))
    (via "Via[0-2]_600:300_um" 45000 -40000 (net GND))
    (via "Via[0-2]_600:300_um" 30000 -45000 (net GND))
  )
)
