(pcb q11-cycle.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "freerouting-rs Q11 synthetic fixture")
    (host_version "one layer; three two-pin nets A, B and C, each with its routed wire (the termination test of depth 1)")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (boundary
      (path pcb 0  0 0  30000 0  30000 20000  0 20000  0 0)
    )
    (via "Via[0-0]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
    )
  )
  (placement
    (component "PAD"
      (place A1 5000 4000 front 0)
      (place A2 25000 4000 front 0)
      (place B1 5000 10000 front 0)
      (place B2 25000 10000 front 0)
      (place C1 5000 16000 front 0)
      (place C2 25000 16000 front 0)
    )
  )
  (library
    (image "PAD"
      (pin RectPad 1 0 0)
    )
    (padstack RectPad
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack "Via[0-0]_600:300_um"
      (shape (circle F.Cu 600))
      (attach off)
    )
  )
  (network
    (net A (pins A1-1 A2-1))
    (net B (pins B1-1 B2-1))
    (net C (pins C1-1 C2-1))
    (class kicad_default "" A B C
      (circuit (use_via "Via[0-0]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
  )
  (wiring
    (wire (path F.Cu 250  5000 4000  25000 4000) (net A))
    (wire (path F.Cu 250  5000 10000  25000 10000) (net B))
    (wire (path F.Cu 250  5000 16000  25000 16000) (net C))
  )
)
