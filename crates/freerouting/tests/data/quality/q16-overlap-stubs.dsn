(pcb q16-overlap-stubs.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "synthetic Q16.4 fixture: copper that KiCad connects by overlap and Java's normal contacts do not")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary
      (path pcb 0  0 0  60000 0  60000 -42000  0 -42000  0 0)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
    )
  )
  (placement
    (component "SMD"
      (place A1 5000 -4000 front 0)
      (place B1 50000 -4000 front 0)
      (place A2 5000 -10000 front 0)
      (place B2 50000 -10000 front 0)
      (place C2 25000 -14000 front 0)
      (place A3 5000 -18000 front 0)
      (place B3 50000 -18000 front 0)
      (place A4 5000 -24000 front 0)
      (place B4 50000 -24000 front 0)
      (place A5 5000 -30000 front 0)
      (place B5 50000 -30000 front 0)
      (place A6 5000 -36000 front 0)
      (place B6 50000 -36000 front 0)
    )
  )
  (library
    (image "SMD"
      (pin RectPad 1 0 0)
    )
    (padstack RectPad
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net STRIP (pins A1-1 B1-1))
    (net TEE (pins A2-1 B2-1 C2-1))
    (net PAD_VIA (pins A3-1 B3-1))
    (net OPEN (pins A4-1 B4-1))
    (net TOUCH (pins A5-1 B5-1))
    (net GAP (pins A6-1 B6-1))
    (class kicad_default "" STRIP TEE PAD_VIA OPEN TOUCH GAP
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
  )
  (wiring
    (wire (path F.Cu 250  5000 -4000  20000 -4000) (net STRIP) (type fix))
    (via "Via[0-1]_600:300_um" 12000 -4000 (net STRIP))
    (wire (path B.Cu 250  12000 -4000  35000 -4000) (net STRIP))
    (via "Via[0-1]_600:300_um" 35000 -4000 (net STRIP))
    (wire (path F.Cu 250  35000 -4000  50000 -4000) (net STRIP))
    (wire (path F.Cu 250  5000 -10000  50000 -10000) (net TEE))
    (wire (path F.Cu 250  25000 -14000  25000 -10050) (net TEE))
    (via "Via[0-1]_600:300_um" 5200 -18000 (net PAD_VIA))
    (wire (path B.Cu 250  5200 -18000  40000 -18000) (net PAD_VIA))
    (via "Via[0-1]_600:300_um" 40000 -18000 (net PAD_VIA))
    (wire (path F.Cu 250  40000 -18000  50000 -18000) (net PAD_VIA))
    (via "Via[0-1]_600:300_um" 8000 -24000 (net OPEN))
    (wire (path B.Cu 250  8000 -24000  40000 -24000) (net OPEN))
    (via "Via[0-1]_600:300_um" 40000 -24000 (net OPEN))
    (wire (path F.Cu 250  40000 -24000  50000 -24000) (net OPEN))
    (wire (path F.Cu 250  5000 -30000  20000 -30000) (net TOUCH) (type fix))
    (via "Via[0-1]_600:300_um" 12000 -29575 (net TOUCH))
    (wire (path B.Cu 250  12000 -29575  40000 -29575) (net TOUCH))
    (via "Via[0-1]_600:300_um" 40000 -29575 (net TOUCH))
    (wire (path F.Cu 250  40000 -29575  50000 -30000) (net TOUCH))
    (wire (path F.Cu 250  5000 -36000  20000 -36000) (net GAP) (type fix))
    (via "Via[0-1]_600:300_um" 12000 -35574.9 (net GAP))
    (wire (path B.Cu 250  12000 -35574.9  40000 -35574.9) (net GAP))
    (via "Via[0-1]_600:300_um" 40000 -35574.9 (net GAP))
    (wire (path F.Cu 250  40000 -35574.9  50000 -36000) (net GAP))
  )
)
