(pcb five_areas.dsn
  (parser
    (string_quote ")
    (host_cad "KiCad's Pcbnew")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary
      (path pcb 0  0 0  100000 0  100000 -100000  0 -100000  0 0)
    )
    (keepout "tv" (polygon F.Cu 0  1000 -1000  2000 -1000  2000 -2000  1000 -2000
            1000 -1000))
    (via_keepout "vo" (polygon F.Cu 0  3000 -1000  4000 -1000  4000 -2000  3000 -2000
            3000 -1000))
    (wire_keepout "to" (polygon B.Cu 0  5000 -1000  6000 -1000  6000 -2000  5000 -2000
            5000 -1000))
    (keepout "fo" (polygon B.Cu 0  7000 -1000  8000 -1000  8000 -2000  7000 -2000
            7000 -1000))
    (keepout "pp" (polygon B.Cu 0  9000 -1000  10000 -1000  10000 -2000  9000 -2000
            9000 -1000))
    (via "Via[0-1]_600:300_um")
  )
  (placement
    (component Pkg:Foot
      (place U1 10000 -10000 front 0 (PN foo))
    )
  )
  (library
    (image Pkg:Foot
      (keepout "" (polygon F.Cu 0  7000 -1000  8000 -1000  8000 -2000  7000 -2000
            7000 -1000))
      (pin Round[A]Pad_1000_um 1 0 0)
    )
  )
)
