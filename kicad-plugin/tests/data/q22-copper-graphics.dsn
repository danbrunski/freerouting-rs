(pcb "q22-copper-graphics.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.7-10.0.7~ubuntu24.04.1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  30000 -20000  0 -20000  0 0  30000 0  30000 -20000)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 200)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component l:jumper
      (place J1 15000 -10000 front 0 (PN x))
    )
    (component l:pad
      (place P1 4000 -4000 front 0 (PN x))
      (place P2 6000 -4000 front 0 (PN x))
    )
    (component l:smdjumper
      (place J2 24000 -14000 front 0 (PN x))
    )
  )
  (library
    (image l:jumper
      (outline (path signal 500  -1800 0  1800 0))
      (pin Round[A]Pad_1200.000000_um 2 -3000 0)
      (pin Round[A]Pad_1200.000000_um 2@1 3000 0)
    )
    (image l:pad
      (pin Rect[T]Pad_1000.000000x1000.000000_um 1 0 0)
    )
    (image l:smdjumper
      (pin Rect[T]Pad_1000.000000x1000.000000_um 1 0 2500)
      (pin Rect[T]Pad_1000.000000x1000.000000_um 2 0 -2500)
    )
    (padstack Round[A]Pad_1200.000000_um
      (shape (circle F.Cu 1200))
      (shape (circle B.Cu 1200))
      (attach off)
    )
    (padstack Rect[T]Pad_1000.000000x1000.000000_um
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net N2
      (pins J1-2 J1-2@1)
    )
    (net FG
      (pins P1-1 P2-1)
    )
    (net N3
      (pins J2-1 J2-2)
    )
    (class kicad_default FG N2 N3
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
